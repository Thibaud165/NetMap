# Time between complete ping scans, in minutes
NETMAP_SCAN_INTERVAL_MINUTES=30

# Timeout before an device is considered disconnected, in seconds
NETMAP_PING_TIMEOUT_SECONDS=10

# Delay between each device during a scan, in seconds
NETMAP_PING_SPACING_SECONDS=1

# Web interface port
NETMAP_PORT=8000

# Application password
NETMAP_PASSWORD=12345678

# Separator displayed below the device name
# Example: aa:bb:cc:11:22:33 \\\ Camera \\\ Garage
NETMAP_FIELD_SEPARATOR=\\\
